{
  "description": "SessionStart (compact|resume|clear|startup): control-anchor re-injection (compaction-survival), ON by default -- opt out with SESSION_WORKFLOW_ANCHOR_HOOKS=0; the no-anchor path returns zero with no output, so it costs a subprocess and nothing else. PostToolUse/Stop: the skill-exercise ledger and the feedback-debt Stop nudge, silent unless SESSION_WORKFLOW_EXERCISE_LEDGER=1 / SESSION_WORKFLOW_FEEDBACK_NUDGE=1. See the plugin README for the exact settings block each opt-out goes in.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume|clear|startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/skills/compaction-survival/scripts/anchor_inject.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Skill$|^mcp__plugin_.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/skills/tool-feedback/scripts/exercise_ledger.py",
              "--record"
            ],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/skills/tool-feedback/scripts/exercise_ledger.py",
              "--stop-nudge"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
