{
  "description": "Two optional SessionStart hooks, both shipped wired but INERT. (1) Live toolkit inventory — silent unless TOOLKIT_AWARENESS_INJECT=1. (2) Control-anchor re-injection on compact/resume (compaction-survival) — silent unless SESSION_WORKFLOW_ANCHOR_HOOKS=1. See the plugin README to enable either.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/skills/toolkit-awareness/scripts/scan_toolkit.py",
              "--session-start"
            ]
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/skills/compaction-survival/scripts/anchor_inject.py"
            ]
          }
        ]
      }
    ]
  }
}
