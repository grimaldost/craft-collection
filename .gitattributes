# Store all text files with LF in the repository; auto-detect text vs binary.
* text=auto

# Always check these out with LF in the working tree, on every platform.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf

# The hook wrappers railform adopt writes run under sh: a CRLF checkout would hand git an
# argument ending in a carriage return, and `railform adopt --check` judges their LF bytes.
.githooks/* text eol=lf
