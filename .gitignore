# Runtime cruft from other tools (not part of the plugin)
.remember/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Env / secrets
.env
*.local

# Plugin build artifacts
*.skill
dist/

# Internal design/build history & review notes — kept local, never published.
# Exception: the keel-method artifacts (ADRs, specs, template kit) are the
# durable coordinate system the method requires committed — tracked below.
docs/*
!docs/adr/
!docs/specs/
!docs/method/
!docs/portability.md
evals/review/

# Compaction-survival anchors — intra-actor working state for long autonomous
# runs, discarded at close (session-workflow's compaction-survival skill).
.claude/anchors/

# OS
.DS_Store
Thumbs.db
