# Runtime cruft from other tools (not part of the plugin)
.remember/

# Python
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Env / secrets
.env
*.local

# Plugin build artifacts
*.skill
dist/

# Internal design/build history & review notes — kept local, never published.
# Exceptions, tracked below: the keel-method artifacts (ADRs, specs, template
# kit) — the durable coordinate system the method requires committed — and the
# house brand kit (docs/brand/), the derivation source for every sibling kit.
docs/*
!docs/adr/
!docs/brand/
!docs/specs/
!docs/method/
!docs/feedback/
!docs/portability.md
evals/review/

# Compaction-survival anchors — intra-actor working state for long autonomous
# runs, discarded at close (session-workflow's compaction-survival skill).
.claude/anchors/

# OS
.DS_Store
Thumbs.db
